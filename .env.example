# Local development CORS allowlist (exact origins; no wildcard).
# Set CORS_ORIGINS explicitly in production for the deployed frontend origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8000,http://127.0.0.1:8000,http://localhost:4173,http://127.0.0.1:4173

# Local-only backend login. Set a password with at least 6 characters and a
# random signing secret with at least 32 characters before starting the API.
LOCAL_AUTH_USERNAME=
LOCAL_AUTH_PASSWORD=
LOCAL_AUTH_SECRET=

# Trusted production data producer integration. Configure the same random
# secret in the backend secret store and the trusted producer secret store.
# Never put this value in frontend configuration or source control.
PRODUCTION_INGESTION_TOKEN=your_secure_token_here

# Leave empty to use the same hostname as the Vite page for local cookie auth.
# Copy this file to frontend/.env.local for Vite.
VITE_API_URL=
